# Copia questo file come ".env" e inserisci le chiavi (il file .env non viene caricato su GitHub).

# Facoltativa ma consigliata: chiave Google Books (https://console.cloud.google.com → API "Books API").
# Senza chiave Google Books può rifiutare le richieste quando la quota gratuita condivisa è esaurita.
GOOGLE_BOOKS_API_KEY=
